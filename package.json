{
  "name": "flyover",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @flyover/db db:generate",
    "db:migrate": "pnpm --filter @flyover/db db:migrate",
    "db:deploy": "pnpm --filter @flyover/db db:deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:test": "cargo test --workspace",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:build": "cargo build --release -p flyover-cli"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@flyover/config": "workspace:*",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "turbo": "2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
