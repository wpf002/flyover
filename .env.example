# Copy to .env. Never commit .env. No real secrets in this file.

# --- Database -------------------------------------------------------------
# Postgres connection string. Local default below. On Railway, reference the
# Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flyover?schema=public"

# --- API (apps/api) -------------------------------------------------------
# Port Fastify listens on. Railway injects PORT, which wins over this.
API_PORT=4000
# Host to bind. 0.0.0.0 in containers, 127.0.0.1 is fine locally.
API_HOST=0.0.0.0
# Origin allowed by CORS. The web app's URL.
WEB_ORIGIN="http://localhost:3000"
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Web (apps/web) -------------------------------------------------------
# Base URL the web app uses to reach the API, server side and client side.
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Tile storage (api + worker) -----------------------------------------
# fs = local directory (dev). s3 = any S3-compatible bucket (prod).
TILE_STORAGE_DRIVER=fs
# Used when TILE_STORAGE_DRIVER=fs. Relative to the repo root.
TILE_STORAGE_DIR=".data/tiles"
# Used when TILE_STORAGE_DRIVER=s3. Leave blank locally.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Worker (apps/worker) -------------------------------------------------
# Where repos get cloned and indexes get written before tiles upload.
WORKER_DATA_DIR=".data/work"
# Path to the flyover CLI binary the worker shells out to.
FLYOVER_BIN="target/release/flyover"
# Comma-separated git hosts the worker will clone from. Everything else is refused.
GIT_HOST_ALLOWLIST="github.com,gitlab.com,bitbucket.org"
# Hard caps per index job.
JOB_MAX_CLONE_MB=20000
JOB_TIMEOUT_MINUTES=90
